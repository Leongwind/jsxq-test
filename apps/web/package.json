{
  "name": "careerlens-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run typecheck && vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json --pretty false && tsc --noEmit -p tsconfig.node.json --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@vicons/tabler": "0.13.0",
    "naive-ui": "2.45.3",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "5.2.4",
    "@vue/test-utils": "2.5.1",
    "happy-dom": "21.0.4",
    "typescript": "5.9.3",
    "vite": "6.4.5",
    "vitest": "3.2.7",
    "vue-tsc": "3.2.6"
  }
}
